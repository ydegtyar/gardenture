{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js *.zip",
    "lint": "tsc --noEmit",
    "itch:pack": "npm run build && rm -f gardenture-html5.zip && (cd dist && zip -r -q ../gardenture-html5.zip .)",
    "itch:zip": "npm run itch:pack",
    "itch:push": "dotenv -e .env.local -- sh -c 'npm run build && butler push dist/ $ITCH_USERNAME/$ITCH_GAME:html5'",
    "itch:push:dev": "dotenv -e .env.local -- sh -c 'butler push dist/ $ITCH_USERNAME/$ITCH_GAME:html5-dev'",
    "itch:status": "dotenv -e .env.local -- sh -c 'butler status $ITCH_USERNAME/$ITCH_GAME'",
    "itch:login": "butler login"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pixi.js": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@locator/babel-jsx": "^0.5.1",
    "@locator/runtime": "^0.5.1",
    "@types/babel__core": "^7.20.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
