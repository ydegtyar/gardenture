# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── itch.io / Butler ──────────────────────────────────────────────────────────

# BUTLER_API_KEY: API key for authenticating Butler CLI with itch.io.
# Generate one at: https://itch.io/user/settings/api-keys
# Used by: npm run itch:push, npm run itch:push:dev
BUTLER_API_KEY="YOUR_BUTLER_API_KEY"

# ITCH_USERNAME: Your itch.io username (the one in your profile URL).
# e.g. https://itch.io/profile/your-username → ITCH_USERNAME=your-username
ITCH_USERNAME="YOUR_ITCH_USERNAME"

# ITCH_GAME: The itch.io game slug (appears in the game page URL).
# e.g. https://your-username.itch.io/gardenture → ITCH_GAME=gardenture
ITCH_GAME="gardenture"

# ── Ad & Monetization Modes ──────────────────────────────────────────────────
# Set to "true" to disable all ads and enable in-game Rare Seed unlocking for personas (itch.io)
VITE_NO_ADS="false"

# ── Unified Platform & Ads Provider ──────────────────────────────────────────
# Active provider: "STUB" (default), "YOUTUBE", "GOOGLE_H5", "POKI", "CRAZYGAMES", "GAMEMONETIZE", "GAMEDISTRIBUTION", "Y8", or "NONE"
VITE_PLATFORM_PROVIDER="STUB"

# Google H5 Games Ads (Ad Placement API / AdSense)
VITE_GOOGLE_H5_CLIENT_ID="ca-pub-0000000000000000"
VITE_GOOGLE_H5_CHANNEL_ID=""
VITE_GOOGLE_H5_DATA_AD_FREQUENCY_HINT="30s"

# Poki SDK (game ID / token)
VITE_POKI_GAME_ID=""

# CrazyGames SDK (v3)
VITE_CRAZYGAMES_GAME_ID=""

# GameMonetize SDK (game ID)
VITE_GAMEMONETIZE_GAME_ID=""

# GameDistribution SDK (game ID)
VITE_GAMEDISTRIBUTION_GAME_ID=""

# Y8 SDK
VITE_Y8_GAME_ID="290159"
VITE_Y8_APP_ID="6ae32a67ba1f868b83779a1f"

# Stub Provider Options (duration in ms for simulated ad playback)
VITE_STUB_AD_DURATION_MS="1000"

